rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'saltechmultimedia@gmail.com'
      );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isActive() {
      return isSuperAdmin() || (hasUserDoc() && currentUserData().status == 'active');
    }

    function isAdmin() {
      return isSuperAdmin() || (hasUserDoc() && currentUserData().role == 'admin' && currentUserData().status == 'active');
    }

    function isStaff() {
      return isAdmin() || (hasUserDoc() && currentUserData().role == 'teacher' && currentUserData().status == 'active');
    }

    function userClassIds() {
      return hasUserDoc() && currentUserData().classIds != null ? currentUserData().classIds : [];
    }

    // USERS COLLECTION
    // Users can read their own profile; staff/admins can read directory.
    // Self-modification of role/status is blocked to prevent privilege escalation.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create, update, delete: if isAdmin();
    }

    // USERNAME LOCK COLLECTION
    // Enforces global username uniqueness.
    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ACADEMIC LEVELS
    match /levels/{levelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // CLASSES & STREAMS
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SUBJECTS
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // LESSONS
    // Published lessons readable by enrolled students, staff, and admins.
    // Staff (Teachers and Admins) can author, update, and manage lesson notes.
    match /lessons/{lessonId} {
      allow read: if isStaff() || (
        isSignedIn() &&
        resource.data.status == 'published'
      );
      allow create, update, delete: if isStaff();
    }

    // QUIZZES
    // Published quizzes readable by enrolled students and staff.
    // Staff (Teachers and Admins) can author, update, and manage quizzes.
    match /quizzes/{quizId} {
      allow read: if isStaff() || (
        isSignedIn() &&
        resource.data.status == 'published'
      );
      allow create, update, delete: if isStaff();
    }

    // SUBMISSIONS
    // Students create/read their own submissions.
    // Staff/Admins can grade and review all submissions.
    match /submissions/{submissionId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['autoScore', 'manualScore', 'totalScore', 'percent', 'status', 'gradedBy', 'gradedAt'])
      );
      allow delete: if isAdmin();
    }

    // NOTIFICATIONS
    // Writable by staff and admins. Readable by all signed-in users.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // NOTIFICATION READ RECEIPTS
    match /notificationReads/{readId} {
      allow read, write: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid
      );
    }

    // AUDIT LOGS
    // Append-only; readable only by admins.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // GLOBAL SETTINGS
    // Publicly readable so theme and branding display on login & app shells.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
