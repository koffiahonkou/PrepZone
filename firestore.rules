rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'saltechmultimedia@gmail.com'
      );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isActive() {
      return isSuperAdmin() || (hasUserDoc() && currentUserData().status == 'active');
    }

    function isAdmin() {
      return isSuperAdmin() || (hasUserDoc() && currentUserData().role == 'admin' && currentUserData().status == 'active');
    }

    function isStaff() {
      return isAdmin() || (hasUserDoc() && currentUserData().role == 'teacher' && currentUserData().status == 'active');
    }

    // GLOBAL SETTINGS
    // Publicly readable so theme, app name, and logo display across all domains (including Vercel).
    // Writable so settings synchronization functions seamlessly across deployments.
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // ACADEMIC LEVELS
    match /levels/{levelId} {
      allow read, write: if true;
    }

    // CLASSES & STREAMS
    match /classes/{classId} {
      allow read, write: if true;
    }

    // SUBJECTS
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // LESSONS
    // Synchronized across AI Studio and Vercel for curriculum and notes
    match /lessons/{lessonId} {
      allow read, write: if true;
    }

    // QUIZZES
    // Synchronized assessments and questions
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    // SUBMISSIONS
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // INQUIRIES & STUDENT-TEACHER Q&A
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // CANNED RESPONSES LIBRARY
    match /cannedResponses/{responseId} {
      allow read, write: if true;
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // NOTIFICATION READ RECEIPTS
    match /notificationReads/{readId} {
      allow read, write: if true;
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if true;
    }

    // USERNAME LOCK COLLECTION
    match /usernames/{usernameLower} {
      allow read, write: if true;
    }
  }
}
